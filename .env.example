# Copy to .env. Every value here has a working default for local development -
# the app runs with no .env at all.
#
# In production (NODE_ENV=production) the app VALIDATES this at boot and refuses
# to start on unsafe values. See validateConfig() in server/src/config.js.

# The replica set started by `docker compose up -d` or scripts/mongo-dev.ps1.
# A standalone mongod will NOT work: change streams and transactions need an oplog.
MONGO_URI=mongodb://127.0.0.1:27018/coilworks?replicaSet=rs0&directConnection=true

# API_PORT, not PORT: the Vite dev server (and some launchers) also read PORT,
# and inheriting it would bind the API on top of the web server.
API_PORT=4000

# REQUIRED IN PRODUCTION. The development fallback below is committed to this
# repository, so anyone could forge an admin token with it - the app will not
# start in production unless this is set to 32+ characters.
#   generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=coilworks-dev-secret-change-me

# REQUIRED IN PRODUCTION. Comma-separated origins allowed to call the API.
# Empty in development means "reflect the request origin", which is what makes
# the Vite proxy and a bare curl both work. "*" is rejected.
CORS_ORIGINS=

# Optional. Unset -> the AI features run on a deterministic offline analyzer
# instead of Claude, so the whole app still works with zero spend.
ANTHROPIC_API_KEY=

# Which model the AI layer calls when a key is present.
ANTHROPIC_MODEL=claude-opus-5

# --- optional tuning ------------------------------------------------------

# Where the built SPA lives. Defaults to ../client/dist relative to the server.
# When it exists, Express serves it and the app runs as a single process.
# CLIENT_DIST=

# Index builds block startup and can take minutes on a large collection, so
# production defaults this to false and syncs deliberately: npm run sync-indexes
# MONGO_AUTO_INDEX=false

# How long raw telemetry is kept. NOTE: only applied when the time-series
# collection is first created - changing it later does not alter an existing one.
# TELEMETRY_RETENTION_SECONDS=2592000

# debug | info | warn | error. Production defaults to info and logs JSON.
# LOG_LEVEL=info
