{
  "name": "coilworks",
  "version": "1.0.0",
  "private": true,
  "description": "Vending fleet operations platform - live telemetry, geospatial restock routing, and AI fault triage.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install && npm run seed",
    "seed": "npm run seed --workspace server",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "simulate": "npm run simulate --workspace server",
    "smoke": "npm run smoke --workspace server",
    "sync-indexes": "npm run sync-indexes --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
